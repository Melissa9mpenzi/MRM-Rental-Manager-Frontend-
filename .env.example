# ── Public platform API (tenant / landlord / agent) ──
VITE_API_URL=http://localhost:8000

# ── Government portal API (NIRA / KCCA / URA / system admin gov routes) ──
VITE_GOV_API_URL=http://localhost:8000

# Production (also in .env.production — override in Vercel if needed):
# VITE_API_URL=https://mrm-rental-manager-backend.vercel.app
# VITE_GOV_API_URL=https://mrm-rental-manager-backend.vercel.app

# Firebase Web app — project rent-5a496 (from Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend: set FIREBASE_CREDENTIALS_PATH for POST /auth/firebase

# Sui wallet (dapp-kit) — devnet | testnet | mainnet
VITE_SUI_NETWORK=devnet
