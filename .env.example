# ── Public platform API (tenant / landlord / agent) ──
# Local dev: use local backend (recommended). CORS allows localhost ↔ local API.
VITE_API_URL=http://localhost:8000
# Only if testing against deployed API from localhost (backend must allow localhost CORS):
# VITE_API_URL=https://mrm-rental-manager-backend.vercel.app

# ── Government portal API (NIRA / KCCA / URA / system admin gov routes) ──
VITE_GOV_API_URL=http://localhost:8000

# Production (also in .env.production — set on Vercel Production):
# VITE_API_URL=https://mrm-rental-manager-backend.vercel.app
# VITE_GOV_API_URL=https://mrm-rental-manager-backend.vercel.app
# VITE_SUI_NETWORK=testnet

# Privy — recommended for Google / Apple / email + embedded Sui wallet
# https://dashboard.privy.io — enable Sui under Embedded wallets → Extended chains
VITE_PRIVY_APP_ID=
# Optional: hosted PNG for Privy OTP emails + modal (defaults to /rentdirect-logo.png on your site)
# VITE_PRIVY_LOGO_URL=https://mrm-rental-manager-frontend-pink.vercel.app/rentdirect-logo.png

# Backend: PRIVY_APP_ID + PRIVY_APP_SECRET for POST /auth/privy

# Firebase (legacy fallback if VITE_PRIVY_APP_ID is empty)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend: FIREBASE_CREDENTIALS_PATH for POST /auth/firebase

# Sui wallet (dapp-kit) — testnet recommended for hackathon demos
VITE_SUI_NETWORK=testnet
